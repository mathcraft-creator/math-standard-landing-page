{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.math-standard.co.kr" }],
      "destination": "https://math-standard.co.kr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "math-standard-landing-page.vercel.app" }],
      "destination": "https://math-standard.co.kr/$1",
      "permanent": true
    }
  ]
}
